{
  "name": "@mawsool/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:facility-scope": "vitest run test/facility-scope.test.ts",
    "test:seed": "vitest run test/seed.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "docs:metrics": "tsx src/cli/metric-definitions-doc.ts",
    "serve:e2e": "tsx src/cli/serve-e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.2",
    "@mawsool/consent": "workspace:*",
    "@mawsool/fhir": "workspace:*",
    "@mawsool/rules": "workspace:*",
    "@mawsool/summary": "workspace:*",
    "@mawsool/types": "workspace:*",
    "cron-parser": "5.10.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
