# Copy to .env. Every variable the repo reads is listed here; there are no secrets in this file.
# Local development values only.

# Shifts every port below by this amount, so a second copy of the repo can run beside the first.
# Defaults: api 4000, person 3000, clinician 3001, ops 3002, Postgres 54329.
PORT_OFFSET=0

# Docker Compose project name. Defaults to mawsool-<PORT_OFFSET>, so two copies never share containers or volumes.
# COMPOSE_PROJECT_NAME=mawsool-0

# Postgres (Docker Compose). The host port is 54329 + PORT_OFFSET.
POSTGRES_USER=mawsool
POSTGRES_PASSWORD=mawsool
POSTGRES_DB=mawsool

# Optional overrides. Built from the values above when unset.
# DATABASE_URL=postgres://mawsool:mawsool@localhost:54329/mawsool
# API_PORT=4000
# API_HOST=127.0.0.1
# PERSON_PORT=3000
# CLINICIAN_PORT=3001
# OPS_PORT=3002
# NEXT_PUBLIC_API_URL=http://localhost:4000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Staff sign-in links are written to the API log, never sent. A clinician's link opens the clinician app; ops
# and admin links open the ops app. Defaults follow the app ports above.
# CLINICIAN_APP_URL=http://localhost:3001
# OPS_APP_URL=http://localhost:3002

# Column encryption for shared bundles and logged summaries: 32 random bytes as base64. The API refuses to start
# without a valid key. The value below is for local development only and protects nothing real; anywhere else,
# generate your own:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BUNDLE_ENCRYPTION_KEY=bWF3c29vbC1sb2NhbC1kZXZlbG9wbWVudC1rZXktMSE=

# The referral-summary assistant. Off by default; while it is off no text is ever sent to a model provider.
# Turning it on needs a provider key, which is never committed. SUMMARY_MODEL defaults to claude-sonnet-5-5.
# SUMMARY_LLM_ENABLED=false
# SUMMARY_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
