# Copy to .env. Every variable the repo reads is listed here; there are no secrets in this file.
# Local development values only.

# Shifts every port below by this amount, so a second copy of the repo can run beside the first.
# Defaults: api 4000, person 3000, clinician 3001, ops 3002, Postgres 54329.
PORT_OFFSET=0

# Docker Compose project name. Defaults to mawsool-<PORT_OFFSET>, so two copies never share containers or volumes.
# COMPOSE_PROJECT_NAME=mawsool-0

# Postgres (Docker Compose). The host port is 54329 + PORT_OFFSET.
POSTGRES_USER=mawsool
POSTGRES_PASSWORD=mawsool
POSTGRES_DB=mawsool

# Optional overrides. Built from the values above when unset.
# DATABASE_URL=postgres://mawsool:mawsool@localhost:54329/mawsool
# API_PORT=4000
# API_HOST=127.0.0.1
# PERSON_PORT=3000
# CLINICIAN_PORT=3001
# OPS_PORT=3002
# NEXT_PUBLIC_API_URL=http://localhost:4000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Staff sign-in links are written to the API log, never sent.
# Public base URL the logged link points at. Defaults to the clinician app.
# STAFF_LINK_BASE_URL=http://localhost:3001
