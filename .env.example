# Copy to .env. Every variable the repo reads is listed here; there are no secrets in this file.
# Local development values only.

# Shifts every port below by this amount, so a second copy of the repo can run beside the first.
# Defaults: api 4000, person 3000, clinician 3001, ops 3002, Postgres 54329.
PORT_OFFSET=0

# Docker Compose project name. Defaults to mawsool-<PORT_OFFSET>, so two copies never share containers or volumes.
# COMPOSE_PROJECT_NAME=mawsool-0

# Postgres (Docker Compose). The host port is 54329 + PORT_OFFSET.
POSTGRES_USER=mawsool
POSTGRES_PASSWORD=mawsool
POSTGRES_DB=mawsool

# Optional overrides. Built from the values above when unset.
# DATABASE_URL=postgres://mawsool:mawsool@localhost:54329/mawsool
# API_PORT=4000
# API_HOST=127.0.0.1
# PERSON_PORT=3000
# CLINICIAN_PORT=3001
# OPS_PORT=3002
# NEXT_PUBLIC_API_URL=http://localhost:4000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Staff sign-in links are written to the API log, never sent. A clinician's link opens the clinician app; ops
# and admin links open the ops app. Defaults follow the app ports above.
# CLINICIAN_APP_URL=http://localhost:3001
# OPS_APP_URL=http://localhost:3002

# Column encryption for shared bundles and logged summaries: 32 random bytes as base64. The API refuses to start
# without a valid key. The value below is for local development only and protects nothing real; anywhere else,
# generate your own:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BUNDLE_ENCRYPTION_KEY=bWF3c29vbC1sb2NhbC1kZXZlbG9wbWVudC1rZXktMSE=

# Front doors that may hand a positive screen to Mawsool (POST /inbound/screens), each signed with its own key
# (HMAC-SHA256, at least 32 characters). A door with no key here is refused. The values below are for local
# development only and protect nothing real; anywhere else, generate your own. An invite's claim link opens
# PERSON_APP_URL (default http://localhost:3000, moved by PORT_OFFSET).
# PERSON_APP_URL=http://localhost:3000
INBOUND_KEY_TAMM=dev-only-tamm-signing-key-not-a-secret-0001
INBOUND_KEY_PHC=dev-only-phc-signing-key-not-a-secret-00002
INBOUND_KEY_SCHOOL=dev-only-school-signing-key-not-a-secret-03

# Demo mode. Without it the demo routes (move the demo clock, reset to the seed) do not exist: they answer 404 and the
# admin panel in the ops app shows them as off. Set it to true for a demo; `true` or `1` turns it on, unset or `false`
# or `0` leaves it off, and anything else stops the API. See docs/running-the-demo.md.
# DEMO_MODE=true

# The referral-summary assistant. Off by default; while it is off no text is ever sent to a model provider.
# With SUMMARY_LLM_ENABLED on, SUMMARY_PROVIDER must be set; there is no default, so you choose where the text goes and
# which account pays: `anthropic` (Anthropic's API, needs ANTHROPIC_API_KEY) or `foundry` (Claude on Microsoft Foundry,
# needs SUMMARY_FOUNDRY_API_KEY and SUMMARY_FOUNDRY_RESOURCE). Keys are never committed.
# SUMMARY_FOUNDRY_RESOURCE is the resource name only, as shown in the Foundry portal (for example my-resource), not a host name.
# SUMMARY_MODEL defaults to claude-sonnet-5-5. On Foundry it is the deployment name, which defaults to the model id.
# The Foundry settings are deliberately not the ANTHROPIC_FOUNDRY_* names that Claude Code and the Foundry SDK read: a value
# exported in your shell would silently win over this file.
# SUMMARY_LLM_ENABLED=false
# SUMMARY_PROVIDER=
# SUMMARY_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# SUMMARY_FOUNDRY_API_KEY=
# SUMMARY_FOUNDRY_RESOURCE=

# Which mock "delivers" outbound messages (staff sign-in links, clinic links, sample text reminders): `log` (the default) writes
# to the API's log, `console` prints; nothing is ever sent. Anything else stops the API.
# NOTIFIER_DRIVER=log

# Hosted-demo settings. All of them are off or unset by default, and nothing changes without them.
# Per-client rate limits on the draft, guest sign-in, reset, clock, invite and sign-in-link routes. `true` or `1` turns them on; anything else but unset, `false` or `0` stops the API.
# RATE_LIMIT=
# The header that carries the real client address behind a proxy (lower-case letters, digits and hyphens). Set only when the origin accepts traffic from that proxy alone. Unset: the socket address.
# CLIENT_IP_HEADER=
# At most this many AI drafts per UTC day, then the template. Unset: no cap. 0: no AI draft at all.
# SUMMARY_DAILY_LIMIT=
# When set, the AI drafts only for a request that carries this code (8 to 64 characters: lower-case letters, digits and hyphens). Unset: no code needed.
# AI_DEMO_CODE=
# Milliseconds after a reset during which another reset is refused. Unset or 0: no cool-down.
# DEMO_RESET_COOLDOWN_MS=
# A five-field cron expression (UTC) on which a demo resets itself, for example 0 23 * * *. Needs DEMO_MODE. Unset: no nightly reset.
# DEMO_RESET_CRON=

# The person app's public-demo build (build time only): the crisis screen dials nothing, a note warns not to enter real details,
# and the consent screen asks for the demo code. `true` or unset; anything else fails `next build`.
# NEXT_PUBLIC_PUBLIC_DEMO=
