# Settings for infra/azure/deploy.sh. The real file is <workspace root>/.local/azure.env (git-ignored; AZURE_ENV_FILE overrides).
# Create it with `infra/azure/deploy.sh --init`: it copies this file and fills the secrets below with newly generated values,
# without printing them. A name left empty here is filled by --init (secrets) or takes its default (the rest).
# Plain KEY=value lines, no spaces around `=`; the file is sourced by bash, so quote a value that has spaces.

# --- Where ----------------------------------------------------------------------------------------------------------
AZURE_SUBSCRIPTION=
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=

# --- Which stage ------------------------------------------------------------------------------------------------------
# azure: the apps keep their azurecontainerapps.io addresses, ingress open (stage 3A).
# cloudflare: the four hostnames under CF_DOMAIN behind Cloudflare, ingress locked to Cloudflare's addresses (stage 3B).
EDGE=
# off: the template writes every draft (no AI provider, no key). on: Anthropic's API (needs ANTHROPIC_API_KEY).
AI=

# --- Secrets (generated by --init; never printed, never committed) ------------------------------------------------------
BUNDLE_ENCRYPTION_KEY=
INBOUND_KEY_TAMM=
INBOUND_KEY_PHC=
INBOUND_KEY_SCHOOL=
POSTGRES_ADMIN_PASSWORD=

# --- Only with AI=on --------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Only with EDGE=cloudflare ----------------------------------------------------------------------------------------
CF_DOMAIN=
# Cloudflare Origin CA certificate and its key (PEM files), downloaded once from the dashboard.
ORIGIN_CERT_FILE=
ORIGIN_KEY_FILE=
# Optional: a token scoped to the zone (DNS edit and Configuration Rules). Without it cloudflare.sh only prints what to enter by hand.
CF_API_TOKEN=

# --- Optional name overrides (defaults are derived from the subscription, so a rerun finds the same resources) ------------
ACR_NAME=
PG_SERVER_NAME=
ENV_NAME=
